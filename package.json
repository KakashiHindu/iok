    "frontend:lint": "npm --prefix frontend run lint",
    "frontend:typecheck": "npm --prefix frontend run typecheck",
    "frontend:test": "npm --prefix frontend run test -- --run",
    "backend:test": "python -m pytest backend/tests ml/tests",
    "lint": "npm --prefix frontend run lint",
    "typecheck": "npm --prefix frontend run typecheck",
    "build": "npm --prefix frontend run build",
    "test": "npm --prefix frontend run test -- --run && python -m pytest backend/tests ml/tests"
  }
